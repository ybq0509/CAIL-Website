[Unit]
Description=CAIL CMS GitHub OAuth service
After=network-online.target

[Service]
Type=simple
User=cail-cms
WorkingDirectory=/opt/cail-cms-auth
EnvironmentFile=/opt/cail-cms-auth/.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
